  "initials": {
    "k": "像「哥」的 g，不送气",
    "kh": "像「科」的 k，送气",
    "ng": "像「昂」最后的 ng，放在开头读",
    "j": "像「鸡」的 j",
    "ch": "像「七」的 q",
    "s": "像「丝」的 s",
    "y": "像「呀」的 y",
    "d": "浊音 d，声带要振动，比「多」更重",
    "t": "像「多」的 d，不送气",
    "th": "像「他」的 t，送气",
    "n": "像「你」的 n",
    "b": "浊音 b，声带要振动，比「波」更重",
    "p": "像「玻」的 b，不送气",
    "ph": "像「坡」的 p，送气",
    "f": "像「夫」的 f",
    "m": "像「妈」的 m",
    "r": "舌尖轻轻打一下的 r，口语里常读成 l",
    "l": "像「拉」的 l",
    "w": "像「哇」的 w",
    "h": "像「喝」的 h",
    "": "开头的 อ 不发音，直接读后面的元音"
  },
  "finals": {
    "k": "收在 k 的口型，不爆出声（像粤语「得」的尾音）",
    "t": "收在 t 的口型，不爆出声（像粤语「一 yat」的尾音）",
    "p": "嘴唇闭上收住，不爆出声（像粤语「十 sap」的尾音）",
    "n": "像「安」最后的 n",
    "m": "嘴唇闭上，像「姆」",
    "ng": "像「昂」最后的 ng",
    "w": "收尾轻轻带一个「乌」",
    "y": "收尾轻轻带一个「衣」"
  },
  "vowels": {
    "a": {
      "say": "อะ",
      "zh": "短 a，像很短的「啊」"
    },
    "aa": {
      "say": "อา",
      "zh": "长 a，「啊——」拖长"
    },
    "i": {
      "say": "อิ",
      "zh": "短 i，像很短的「衣」"
    },
    "ii": {
      "say": "อี",
      "zh": "长 i，「衣——」拖长"
    },
    "ue": {
      "say": "อึ",
      "zh": "短 ue：嘴角往两边拉，不圆唇地发「乌」"
    },
    "uue": {
      "say": "อือ",
      "zh": "长 ue：嘴角往两边拉，不圆唇的「乌——」"
    },
    "u": {
      "say": "อุ",
      "zh": "短 u，像很短的「乌」"
    },
    "uu": {
      "say": "อู",
      "zh": "长 u，「乌——」拖长"
    },
    "e": {
      "say": "เอะ",
      "zh": "短 e，像很短的「诶」"
    },
    "ee": {
      "say": "เอ",
      "zh": "长 e，「诶——」拖长"
    },
    "ae": {
      "say": "แอะ",
      "zh": "短 ae，嘴比「诶」张得更大（像英语 cat 的 a）"
    },
    "aae": {
      "say": "แอ",
      "zh": "长 ae，嘴张大的「诶——」"
    },
    "o": {
      "say": "โอะ",
      "zh": "短 o，圆唇，像很短的「哦」"
    },
    "oo": {
      "say": "โอ",
      "zh": "长 o，圆唇的「哦——」"
    },
    "aw": {
      "say": "เอาะ",
      "zh": "短 aw，嘴张大的「奥」（像英语 law），很短"
    },
    "aaw": {
      "say": "ออ",
      "zh": "长 aw，嘴张大的「奥——」"
    },
    "oe": {
      "say": "เออะ",
      "zh": "短 oe，像很短的「额」"
    },
    "ooe": {
      "say": "เออ",
      "zh": "长 oe，「额——」拖长"
    },
    "ia": {
      "say": "เอีย",
      "zh": "ia，「衣」滑到「啊」"
    },
    "uea": {
      "say": "เอือ",
      "zh": "uea，不圆唇的「乌」滑到「啊」"
    },
    "ua": {
      "say": "อัว",
      "zh": "ua，「乌」滑到「啊」"
    },
    "ai": {
      "say": "ไอ",
      "zh": "ai，像「爱」"
    },
    "ao": {
      "say": "เอา",
      "zh": "ao，像「凹」"
    },
    "am": {
      "say": "อำ",
      "zh": "am，「啊」完闭上嘴收 m"
    }
  },
  "tones": {
    "1": {
      "name": "平调",
      "zh": "平平的中音，像普通话第一声，但低一点"
    },
    "2": {
      "name": "低调",
      "zh": "低而平，略往下，比平调低"
    },
    "3": {
      "name": "降调",
      "zh": "先高再往下掉，像普通话第四声"
    },
    "4": {
      "name": "高调",
      "zh": "起得高、尾巴往上扬，像偏高的普通话第二声"
    },
    "5": {
      "name": "升调",
      "zh": "先往下压再升上去，像普通话第三声"
    }
  },
  "marks": {
    "่": "ไม้เอก",
    "้": "ไม้โท",
    "๊": "ไม้ตรี",
    "๋": "ไม้จัตวา"
  }
